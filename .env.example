# FastAPI origin used by Server Components and the user-safe BFF.
BACKEND_URL=http://localhost:8000
# Production: BACKEND_URL=https://api.gathos.com

# Enables local fixture data for visual development only. Production builds
# ignore demo mode even if this value is accidentally present.
DASHBOARD_DEMO_MODE=false

# Optional local cookie verification; must match FastAPI SESSION_SECRET.
# Server only: never prefix with NEXT_PUBLIC_. Leave unset to use backend verification.
SESSION_SECRET=

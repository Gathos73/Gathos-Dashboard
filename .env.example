# FastAPI origin used by Server Components and the user-safe BFF.
BACKEND_URL=http://localhost:8000
# Production: BACKEND_URL=https://api.gathos.live

# Enables local fixture data for visual development only. Production builds
# ignore demo mode even if this value is accidentally present.
DASHBOARD_DEMO_MODE=false

# Optional local cookie verification; must match FastAPI SESSION_SECRET.
# Server only: never prefix with NEXT_PUBLIC_. Leave unset to use backend verification.
SESSION_SECRET=

# Optional cookie namespace; must match backend.
COOKIE_PREFIX=

# External origin when running behind a reverse proxy.
APP_ORIGIN=

# Server-only secret shared with backend; never NEXT_PUBLIC_.
BFF_FORWARDING_SECRET=
# Set only to an IP header OVERWRITTEN by the trusted edge.
# Dev Caddy uses x-gathos-edge-ip. Leave unset until the edge is configured.
BFF_TRUSTED_CLIENT_IP_HEADER=
